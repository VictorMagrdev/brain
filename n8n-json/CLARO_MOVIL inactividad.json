      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cliente, id_conversacion, num_advertencia, session_wpp, paso, TIMESTAMPDIFF(MINUTE, fecha_modificacion, NOW()) AS minutos FROM claro_movil WHERE tipo='CLARO_MOVIL' AND id_cuenta='1' AND paso IN ('1','2','3','4','5') AND num_advertencia < 3 AND id_conversacion IS NOT NULL AND id_conversacion <> '' AND TIMESTAMPDIFF(MINUTE, fecha_modificacion, NOW()) >= (num_advertencia+1)*1",
        "options": {}
      },
