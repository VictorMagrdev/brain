		{"id":"b1c2d3e4f5a60007","fromNode":"a1b2c3d4e5f60004","fromSide":"bottom","toNode":"a1b2c3d4e5f6000e","toSide":"top","toEnd":"arrow","label":"implementa"},
		{"id":"b1c2d3e4f5a60008","fromNode":"a1b2c3d4e5f6000a","fromSide":"right","toNode":"a1b2c3d4e5f60006","toSide":"left","toEnd":"arrow","label":"justifica"},
